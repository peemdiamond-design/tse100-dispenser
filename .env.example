# ===== TU Smart Rx backend — คัดลอกเป็นไฟล์ .env แล้วกรอกค่าจริง (ห้าม commit .env) =====
PORT=80

# Omise (สร้างคีย์ชุดใหม่ใน dashboard.omise.co — คีย์เก่าหลุดอยู่ใน git history แล้ว)
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxx
OMISE_MIN_AMOUNT=20
RETURN_URI=https://tuya.peemcn25.dev

# Firebase Admin: Firebase Console › Project settings › Service accounts › Generate new private key
FIREBASE_SERVICE_ACCOUNT=./firebase-adminsdk.json
ADMIN_ID=6910616249

# MQTT broker ส่วนตัว (เช่น HiveMQ Cloud Serverless) — ใช้ user ของ "backend"
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=tse-backend
MQTT_PASSWORD=change-me
MQTT_TOPIC_CMD=tse100/kiosk1/cmd
MQTT_TOPIC_STATUS=tse100/kiosk1/status

# กุญแจเซ็นคำสั่งจ่ายยา (ต้องตรงกับ DISPENSE_SECRET ใน secrets.h ของ ESP32)
# สร้างด้วย: openssl rand -hex 32
DISPENSE_SECRET=

# โดเมนที่อนุญาตให้เรียก API (คั่นด้วย ,)
ALLOWED_ORIGINS=https://tuya.peemcn25.dev
